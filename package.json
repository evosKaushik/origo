{
  "name": "@evoskaushik/create-origo-app",
  "version": "0.1.0",
  "description": "A modern project scaffolding CLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/evosKaushik/origo.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/evosKaushik/origo#readme",
  "bugs": {
    "url": "https://github.com/evosKaushik/origo/issues"
  },
  "type": "module",
  "bin": {
    "origo": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && node dist/index.js",
    "dev": "concurrently \"tsc --watch\" \"node --watch dist/index.js\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "preview": "npm run build && npm pack --dry-run",
    "pack:local": "npm run build && npm pack",
    "try:cli": "npm run build && node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "generator",
    "react",
    "vite",
    "express",
    "fastify",
    "typescript",
    "tailwind",
    "prisma",
    "mongoose"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0"
  }
}
