{
  "name": "create-origo-app",
  "version": "0.1.0",
  "description": "A modern project scaffolding CLI",
  "type": "module",
  "bin": {
    "origo": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "concurrently \"tsc --watch\" \"node --watch dist/index.js\"",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1"
  }
}
